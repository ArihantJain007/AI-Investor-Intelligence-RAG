# ── Gemini Developer API ──────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# Model to use for chat and KPI extraction.
# gemini-3.1-flash-lite is recommended for low-cost / free-tier quota.
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Hugging Face Inference API ────────────────────────────────────────────────
HUGGINGFACEHUB_API_TOKEN=your_huggingface_read_token

# Embedding model served via the Hugging Face Inference API (remote).
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Local persistence ─────────────────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION=investor_reports
METRICS_FILE=data/financial_metrics.json
